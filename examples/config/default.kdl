// Hagia's generic freeze-profile default.
// Copy this file to ~/.config/hagia/config.kdl before customizing it.

schema 1

policy {
  layout "scroller"
  // The cycle key steps through these; every layout also has a select action,
  // bound or not. Eleven are available: the five below plus center-tile,
  // right-tile, vertical-grid, deck, spiral, and tgmix.
  layout-cycle "scroller" "tile" "grid" "monocle" "vertical-scroller"
  view-count 9
  outer-gap 0
  inner-gap 0
  // Horizontal scroller viewport bias in pixels; 0 keeps the focused column
  // centering rule untouched.
  viewport-offset 0
  // Tile master area: how many windows share it, and what percentage of the
  // width it takes. Both are adjustable at runtime from the keys below.
  master-count 1
  master-ratio 50
  // How far one press of increase-gaps or decrease-gaps moves both gaps.
  gap-step 2
  // Scratchpad windows appear centered at this fraction of the output.
  scratchpad-size 70 60
  // cycle-column-width steps the focused column through these percentages.
  column-width-presets 33 50 67
  // Freshly floated windows take the whole output; set percentages to size
  // them instead, e.g. floating-size 60 60.
  // floating-size 0 0
  // Name a workspace and its indicator says so; the slot number stays the
  // identity. Per-view starting layouts follow the same slot addressing.
  // view-name 1 "code"
  // view-layout 1 "scroller"
}

shell {
  enabled #true
  panel 28
}

shortcut {
  profile "default"
  bind "Ctrl+Alt+Delete" "session:logout"
  bind "Super+Return" "session:spawn-terminal"
  bind "Super+b" "session:spawn-browser"
  bind "Super+p" "session:window-switcher"
  bind "Super+q" "session:close-window"
  bind "Super+h" "policy:focus-column-prev"
  bind "Super+j" "policy:focus-window-below"
  bind "Super+k" "policy:focus-window-above"
  bind "Super+l" "policy:focus-column-next"
  bind "Super+Tab" "policy:focus-last"
  bind "Super+Shift+Tab" "policy:focus-prev"
  bind "Super+Left" "policy:focus-output-next"
  bind "Super+Right" "policy:focus-output-prev"
  bind "Super+Shift+Left" "policy:move-to-output-prev"
  bind "Super+Shift+Right" "policy:move-to-output-next"
  bind "Super+u" "policy:focus-occupied-workspace-next"
  bind "Super+i" "policy:focus-occupied-workspace-prev"
  bind "Super+Shift+u" "policy:focus-view-next"
  bind "Super+Shift+i" "policy:focus-view-prev"
  bind "Super+Shift+n" "policy:new-workspace"
  bind "Super+1" "policy:focus-workspace 1"
  bind "Super+2" "policy:focus-workspace 2"
  bind "Super+3" "policy:focus-workspace 3"
  bind "Super+4" "policy:focus-workspace 4"
  bind "Super+5" "policy:focus-workspace 5"
  bind "Super+6" "policy:focus-workspace 6"
  bind "Super+7" "policy:focus-workspace 7"
  bind "Super+8" "policy:focus-workspace 8"
  bind "Super+9" "policy:focus-workspace 9"
  bind "Super+Ctrl+1" "policy:move-to-workspace 1"
  bind "Super+Ctrl+2" "policy:move-to-workspace 2"
  bind "Super+Ctrl+3" "policy:move-to-workspace 3"
  bind "Super+Ctrl+4" "policy:move-to-workspace 4"
  bind "Super+Ctrl+5" "policy:move-to-workspace 5"
  bind "Super+Ctrl+6" "policy:move-to-workspace 6"
  bind "Super+Ctrl+7" "policy:move-to-workspace 7"
  bind "Super+Ctrl+8" "policy:move-to-workspace 8"
  bind "Super+Ctrl+9" "policy:move-to-workspace 9"
  bind "Super+f" "policy:toggle-maximized"
  bind "Super+Shift+f" "policy:toggle-fullscreen"
  bind "Super+m" "policy:toggle-maximized"
  bind "Super+t" "policy:toggle-floating"
  bind "Super+Shift+t" "policy:toggle-floating"
  bind "Super+Shift+b" "policy:minimize"
  bind "Super+Alt+b" "policy:restore-minimized"
  bind "Super+s" "policy:move-to-scratchpad"
  bind "Super+Alt+s" "policy:toggle-scratchpad"
  bind "Super+Shift+s" "policy:restore-scratchpad"
  bind "Super+n" "policy:switch-layout"
  bind "Super+Ctrl+e" "policy:toggle-named-scratchpad 1"
  bind "Super+Ctrl+Shift+e" "policy:move-to-named-scratchpad 1"
  bind "Super+a" "policy:toggle-named-scratchpad 2"
  bind "Super+Shift+a" "policy:move-to-named-scratchpad 2"
  bind "Super+Shift+z" "policy:consume-window"
  bind "Super+Ctrl+z" "policy:expel-window"

  // Moving what is focused, on the same axes the focus keys use. A window
  // pushed past the last column opens a column there rather than wrapping.
  bind "Super+Ctrl+h" "policy:move-window-column-prev"
  bind "Super+Ctrl+j" "policy:move-window-below"
  bind "Super+Ctrl+k" "policy:move-window-above"
  bind "Super+Ctrl+l" "policy:move-window-column-next"
  bind "Super+Alt+h" "policy:move-column-prev"
  bind "Super+Alt+l" "policy:move-column-next"
  bind "Super+Alt+Home" "policy:move-column-first"
  bind "Super+Alt+End" "policy:move-column-last"
  bind "Super+Home" "policy:focus-column-first"
  bind "Super+End" "policy:focus-column-last"
  bind "Super+z" "policy:promote-column"
  bind "Super+Ctrl+u" "policy:move-to-view-next"
  bind "Super+Ctrl+i" "policy:move-to-view-prev"
  bind "Super+Shift+h" "policy:move-view-to-output-prev"
  bind "Super+Shift+l" "policy:move-view-to-output-next"
  bind "Super+-" "policy:resize-width -0.1"
  bind "Super+=" "policy:resize-width 0.1"
  // bind "Super+r" "policy:cycle-column-width"
  // bind "Super+Shift+r" "policy:cycle-column-width-back"
  // bind "Super+Alt+z" "policy:consume-window-prev"
  bind "Super+Shift+-" "policy:resize-height -0.1"
  bind "Super+Shift+=" "policy:resize-height 0.1"

  // Layout knobs. The master keys shape the tile layout; the gap keys apply
  // everywhere, and toggling gaps hides them without discarding the values
  // configured above.
  bind "Super+bracketleft" "policy:decrease-master-count"
  bind "Super+bracketright" "policy:increase-master-count"
  bind "Super+comma" "policy:decrease-master-ratio"
  bind "Super+period" "policy:increase-master-ratio"
  bind "Super+0" "policy:toggle-gaps"
  bind "Super+Ctrl+minus" "policy:decrease-gaps"
  bind "Super+Ctrl+equal" "policy:increase-gaps"
  bind "Super+Ctrl+m" "policy:maximize-column"

  // Window groups. Grouping decides what one key steps through; it changes
  // nothing about where a layout puts a window.
  bind "Super+y" "policy:group-windows"
  bind "Super+Shift+y" "policy:ungroup-window"
  bind "Super+Ctrl+y" "policy:focus-next-in-group"

  // Direct layout selection. The cycle key above reaches every mode; these
  // reach one mode each. The remaining named scratchpad slots follow the same
  // pattern as the two bound above.
  // bind "Super+Ctrl+Alt+1" "policy:layout-scroller"
  // bind "Super+Ctrl+Alt+2" "policy:layout-tile"
  // bind "Super+Ctrl+Alt+3" "policy:layout-grid"
  // bind "Super+Ctrl+Alt+4" "policy:layout-monocle"
  // bind "Super+Ctrl+Alt+5" "policy:layout-vertical-scroller"
  // bind "Super+Ctrl+Alt+6" "policy:layout-center-tile"
  // bind "Super+Ctrl+Alt+7" "policy:layout-right-tile"
  // bind "Super+Ctrl+Alt+8" "policy:layout-vertical-grid"
  // bind "Super+Ctrl+Alt+9" "policy:layout-deck"
  // bind "Super+Ctrl+Alt+0" "policy:layout-spiral"
  // bind "Super+Ctrl+Alt+d" "policy:layout-dwindle"
  // bind "Super+Ctrl+Alt+m" "policy:layout-mixed"

  // One directional split, read by whichever tree layout is active: frame
  // tree, Notion and i3 open the new cell now, dwindle aims where the next
  // window lands and cancels if you press the same direction twice.
  // bind "Super+Alt+Shift+h" "policy:split-left"
  // bind "Super+Alt+Shift+j" "policy:split-down"
  // bind "Super+Alt+Shift+k" "policy:split-up"
  // bind "Super+Alt+Shift+l" "policy:split-right"
  // bind "Super+Ctrl+r" "policy:toggle-named-scratchpad 3"
  // bind "Super+Ctrl+Shift+r" "policy:move-to-named-scratchpad 3"
  // bind "Super+Ctrl+d" "policy:toggle-named-scratchpad 4"
  // bind "Super+Ctrl+Shift+d" "policy:move-to-named-scratchpad 4"

  // Whole-view swaps: trade the windows of the active view with another slot.
  // bind "Super+Shift+1" "policy:swap-with-view 1"
  // bind "Super+Shift+2" "policy:swap-with-view 2"
  // bind "Super+Shift+3" "policy:swap-with-view 3"
  // bind "Super+Shift+4" "policy:swap-with-view 4"
  // bind "Super+Shift+5" "policy:swap-with-view 5"
  // bind "Super+Shift+6" "policy:swap-with-view 6"
  // bind "Super+Shift+7" "policy:swap-with-view 7"
  // bind "Super+Shift+8" "policy:swap-with-view 8"
  // bind "Super+Shift+9" "policy:swap-with-view 9"

  // Tag-mask toggles: multi-tag membership beyond the workspace model.
  // Uncomment the slots you use; the actions are always registered.
  // bind "Super+Alt+1" "policy:toggle-view-tag 1"
  // bind "Super+Alt+2" "policy:toggle-view-tag 2"
  // bind "Super+Alt+3" "policy:toggle-view-tag 3"
  // bind "Super+Alt+4" "policy:toggle-view-tag 4"
  // bind "Super+Alt+5" "policy:toggle-view-tag 5"
  // bind "Super+Alt+6" "policy:toggle-view-tag 6"
  // bind "Super+Alt+7" "policy:toggle-view-tag 7"
  // bind "Super+Alt+8" "policy:toggle-view-tag 8"
  // bind "Super+Alt+9" "policy:toggle-view-tag 9"
  // bind "Super+Ctrl+Shift+1" "policy:toggle-window-tag 1"
  // bind "Super+Ctrl+Shift+2" "policy:toggle-window-tag 2"
  // bind "Super+Ctrl+Shift+3" "policy:toggle-window-tag 3"
  // bind "Super+Ctrl+Shift+4" "policy:toggle-window-tag 4"
  // bind "Super+Ctrl+Shift+5" "policy:toggle-window-tag 5"
  // bind "Super+Ctrl+Shift+6" "policy:toggle-window-tag 6"
  // bind "Super+Ctrl+Shift+7" "policy:toggle-window-tag 7"
  // bind "Super+Ctrl+Shift+8" "policy:toggle-window-tag 8"
  // bind "Super+Ctrl+Shift+9" "policy:toggle-window-tag 9"
  pointer-bind "Super+left" "policy:move"
  pointer-bind "Super+right" "policy:resize"
}

session {
  terminal "terminal"
  browser "browser"
}

input { inherit-sophia #true; }
output { inherit-sophia #true; }
broker { enabled #false; }
