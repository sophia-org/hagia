/.nimble/
/nimcache/
/tests/nimcache/

# Compiled test binaries land beside their sources. Ignore all of them by the
# extensionless pattern so a new suite cannot leave an untracked ELF the way an
# unlisted one silently would.
/tests/t*
!/tests/*.nim
!/tests/*.kdl

# Built nimble binaries land beside their sources at the repo root. Keep an
# entry here even for a binary this repo no longer builds: deleting a line
# while a stale build is still in the worktree silently un-ignores it, which
# is how a 191 KiB ELF reached a public commit.
/hagia
/hagia_policy_proof
/hagia_shell
