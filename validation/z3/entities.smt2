(set-logic QF_UFLIA)

; Two windows, columns, outputs, tags, and views are enough to search the
; ownership, uniqueness, nonempty-membership, and dangling-reference boundary.
(declare-const w1 Int)
(declare-const w2 Int)
(declare-const c1 Int)
(declare-const c2 Int)
(declare-const o1 Int)
(declare-const o2 Int)
(declare-const t1 Int)
(declare-const t2 Int)
(declare-const v1 Int)
(declare-const v2 Int)
(declare-fun windowColumn (Int) Int)
(declare-fun windowOutput (Int) Int)
(declare-fun columnOutput (Int) Int)
(declare-fun windowHasTag (Int Int) Bool)
(declare-fun viewHasTag (Int Int) Bool)
(declare-fun dynamicTag (Int) Bool)
(declare-fun activeTag (Int) Bool)

(assert (and (> w1 0) (> w2 0) (distinct w1 w2)))
(assert (and (> c1 0) (> c2 0) (distinct c1 c2)))
(assert (and (> o1 0) (> o2 0) (distinct o1 o2)))
(assert (and (> t1 0) (> t2 0) (distinct t1 t2)))
(assert (and (> v1 0) (> v2 0) (distinct v1 v2)))
(assert (or (= (windowColumn w1) c1) (= (windowColumn w1) c2)))
(assert (or (= (windowColumn w2) c1) (= (windowColumn w2) c2)))
(assert (or (= (windowOutput w1) o1) (= (windowOutput w1) o2)))
(assert (or (= (windowOutput w2) o1) (= (windowOutput w2) o2)))
(assert (or (= (columnOutput c1) o1) (= (columnOutput c1) o2)))
(assert (or (= (columnOutput c2) o1) (= (columnOutput c2) o2)))
(assert (= (windowOutput w1) (columnOutput (windowColumn w1))))
(assert (= (windowOutput w2) (columnOutput (windowColumn w2))))
(assert (or (windowHasTag w1 t1) (windowHasTag w1 t2)))
(assert (or (windowHasTag w2 t1) (windowHasTag w2 t2)))
(assert (or (viewHasTag v1 t1) (viewHasTag v1 t2)))
(assert (or (viewHasTag v2 t1) (viewHasTag v2 t2)))
(assert
  (=>
    (dynamicTag t1)
    (or (windowHasTag w1 t1) (windowHasTag w2 t1) (activeTag t1))))
(assert
  (=>
    (dynamicTag t2)
    (or (windowHasTag w1 t2) (windowHasTag w2 t2) (activeTag t2))))

; Each requested bad state must be impossible under the implementation
; invariants above.
(push)
(assert (not (= (windowOutput w1) (columnOutput (windowColumn w1)))))
(check-sat)
(pop)
(push)
(assert (dynamicTag t1))
(assert (not (windowHasTag w1 t1)))
(assert (not (windowHasTag w2 t1)))
(assert (not (activeTag t1)))
(check-sat)
(pop)
(push)
(assert (= w1 w2))
(check-sat)
(pop)
(push)
(assert (and (not (windowHasTag w1 t1)) (not (windowHasTag w1 t2))))
(check-sat)
(pop)
